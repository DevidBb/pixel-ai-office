{
  "name": "pixel-ai-office",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "start": "concurrently -k -n api,web \"node server.mjs\" \"vite\"",
    "dev": "concurrently -k -n api,web \"node server.mjs\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node server.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start:api": "node server.mjs",
    "check": "node --check server.mjs && node --check server/config.mjs && node --check server/llm.mjs && node --check server/office.mjs && node --check server/app.mjs && node --check server/runs.mjs && node --check src/taskEvents.ts && node --check server/eval.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "bench:model": "node scripts/bench-model.mjs",
    "dev:lan": "concurrently -k -n api,web \"OFFICE_ALLOW_LAN=true node server.mjs\" \"OFFICE_HOST=0.0.0.0 vite\"",
    "eval:coffee": "node scripts/eval-coffee.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
