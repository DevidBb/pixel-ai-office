# Получи API key у провайдера модели и вставь его сюда. Не публикуй и не отправляй его в чат.
OPENAI_API_KEY=replace_with_your_api_key

# Модель можно изменить на доступную в твоём API-аккаунте.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Порт локального API-сервера
PORT=8787

# --- Локальная модель через Ollama (пример) ---
# OPENAI_MODEL=qwen3:1.7b
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# Для Ollama ключ не нужен; сервер сам использует родной API /api/chat с think=false.

# --- Выполнение задач (необязательно, ниже значения по умолчанию) ---
# Сколько запросов к модели одновременно. На CPU начни с 1; 2 — после проверки скорости
# (для 2 нужен Ollama с OLLAMA_NUM_PARALLEL>=2, иначе запросы всё равно встанут в очередь Ollama).
LLM_CONCURRENCY=1
# Максимальное время одного запроса к модели, мс. По истечении запрос отменяется.
LLM_TIMEOUT_MS=240000
# Максимальное ожидание свободного слота в очереди, мс.
LLM_QUEUE_TIMEOUT_MS=900000
# Выбор исполнителей CEO: auto (ключевые слова, при неясности — модель), rules (без модели), llm (всегда модель)
CEO_ROUTER_MODE=auto
CEO_ROUTER_TIMEOUT_MS=60000
# Лимит длины ответа сотрудника (токены). qwen3:1.7b на CPU даёт ~5–7 токенов/с.
AGENT_MAX_TOKENS=700
# Лимит, когда в задании просят «коротко»/«кратко». 220 токенов ≈ 35–40 с на CPU.
AGENT_SHORT_MAX_TOKENS=220
# Сводка CEO моделью: auto — только когда задания ролевые (при адресных «Luma 4 — слоган» итог собирается
# из настоящих ответов, это экономит ~3 мин на CPU); true — всегда; false — никогда.
CEO_SUMMARY=auto
CEO_SUMMARY_MAX_TOKENS=600
# Передача результата: зависимые сотрудники ждут данных коллег (исследование → продукт → креатив/продажи → финансы)
# и получают их в подсказке, обрезанными до ~450 символов на источник. auto — только для ролевых заданий
# («запусти бизнес») и при LLM_CONCURRENCY=1: очередь и так идёт по порядку, добавляется лишь ~7 с подсказки
# на источник. Адресные задания («Luma 2 — …; Luma 6 — …») остаются независимыми. true — всегда; false — никогда.
HANDOFF=auto
# Только для Ollama
OLLAMA_THINK=false
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
